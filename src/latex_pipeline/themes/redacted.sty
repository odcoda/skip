% redacted.sty — "REDACTED" classified-document theme for SCP books
% Government dossier / conspiracy aesthetic: monospace headers, red accents,
% classification stamps, typed-document feel.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{redacted}[2026/02/20 SCP REDACTED classified-document theme]

% Load base layer
\RequirePackage{scpbase}

% ─── Additional packages ─────────────────────────────────────────────
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning}
\RequirePackage{courier}       % Courier monospace
\RequirePackage{helvet}        % Helvetica sans-serif
\RequirePackage{titlesec}      % Section title formatting
\RequirePackage{etoolbox}      % Patching commands
\RequirePackage{afterpage}
\IfFileExists{microtype.sty}{\RequirePackage{microtype}}{}

% ─── Color palette ───────────────────────────────────────────────────
% Override/extend base colors
\definecolor{scpred}{RGB}{187,0,0}
\definecolor{scpblack}{RGB}{20,20,20}
\definecolor{scpgray}{RGB}{102,102,102}
\definecolor{scplightgray}{RGB}{240,240,240}
\definecolor{scppaper}{RGB}{252,250,245}
\definecolor{scpyellow}{RGB}{255,200,0}
\definecolor{scpstamp}{RGB}{200,0,0}
\definecolor{scpdarkred}{RGB}{120,0,0}

% ─── Page geometry ───────────────────────────────────────────────────
% 6x9 trade paperback — standard for non-fiction / reference books
\geometry{
  paperwidth=6in,
  paperheight=9in,
  inner=0.68in,
  outer=0.48in,
  top=0.62in,
  bottom=0.60in,
  headheight=13pt,
  headsep=14pt,
  footskip=20pt
}

% Page background tint
\pagecolor{scppaper}

% ─── Typography ──────────────────────────────────────────────────────
% Body: Latin Modern serif (already loaded by scpbase)
% Sans: Helvetica for labels
% Mono: Courier for headers and dialogue
\AtBeginDocument{%
  \fontsize{9.3pt}{11.7pt}\selectfont
  \setlength{\parindent}{1.1em}
  \setlength{\parskip}{0.28em}
}

% ─── Headers and footers ────────────────────────────────────────────
\fancyhf{}
\fancyhead[LO]{%
  \footnotesize\sffamily\color{scpgray}%
  CLASSIFIED \textendash{} LEVEL 4%
}
\fancyhead[RE]{%
  \footnotesize\sffamily\color{scpgray}%
  CLASSIFIED \textendash{} LEVEL 4%
}
\fancyhead[RO,LE]{%
  \footnotesize\sffamily\color{scpgray}%
  SCP FOUNDATION ARCHIVE%
}
\fancyfoot[C]{%
  \footnotesize\sffamily\color{scpgray}%
  \thepage%
}
\fancyfoot[LO,RE]{%
  \scriptsize\sffamily\color{scpgray!60}%
  UNAUTHORIZED ACCESS PROHIBITED%
}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Red rule under header
\renewcommand{\headrule}{%
  \vspace{2pt}%
  {\color{scpred}\hrule height 0.8pt}%
}

% Plain page style (chapter openers)
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\footnotesize\sffamily\color{scpgray}\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% ─── Chapter titles ──────────────────────────────────────────────────
\titleformat{\chapter}[display]
  {\normalfont\large\ttfamily\bfseries\color{scpblack}\raggedright}
  {\MakeUppercase{\chaptertitlename}\ \thechapter}
  {6pt}
  {\color{scpred}\titlerule[1.6pt]\vspace{4pt}}
\titlespacing*{\chapter}{0pt}{-8pt}{14pt}

% ─── Section titles (SCP numbers) ───────────────────────────────────
\titleformat{\section}
  {\normalfont\normalsize\bfseries\ttfamily\color{scpblack}}
  {}
  {0pt}
  {}
  [\vspace{2pt}{\color{scpred}\titlerule[1.2pt]}\vspace{3pt}]

% ─── Subsection titles (Containment, Description, etc.) ─────────────
\titleformat{\subsection}
  {\normalfont\small\bfseries\sffamily\color{scpblack}\MakeUppercase}
  {}
  {0pt}
  {}

% ─── Redaction bars ──────────────────────────────────────────────────
% Thicker "marker-style" redaction bars, less like raw Unicode blocks.
\renewcommand{\redact}[1]{%
  \tikz[baseline=-0.62ex,x=1em,y=1ex]{%
    \pgfmathsetmacro{\rw}{max(0.72,0.44*#1)}%
    \fill[scpblack] (0,0) rectangle (\rw,1.70);
    \fill[scpblack,opacity=0.32] (0.04,1.50) -- (\rw,1.50) -- (\rw,2.08) -- (0.12,1.90) -- cycle;
    \fill[scpblack,opacity=0.26] (0.08,-0.22) -- (\rw,-0.22) -- (\rw-0.10,0.22) -- (0,0.10) -- cycle;
    \draw[white,opacity=0.06,line width=0.12ex] (0.15,0.45) -- (\rw-0.10,1.22);
    \draw[white,opacity=0.05,line width=0.10ex] (0.10,1.43) -- (\rw-0.15,0.34);
  }%
}
\renewcommand{\blackbox}{\redact{1}}

% ─── Override semantic commands ──────────────────────────────────────

% Containment procedures — tcolorbox with red left bar
\renewcommand{\containment}{%
  \vspace{6pt}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=scplightgray!60,
    colframe=scplightgray,
    boxrule=0pt,
    borderline west={2pt}{0pt}{scpred},
    sharp corners,
    left=6pt, right=5pt, top=3pt, bottom=3pt,
    fontupper=\sffamily\footnotesize
  ]%
  \textbf{\MakeUppercase{Special Containment Procedures}}%
  \end{tcolorbox}%
  \vspace{2pt}%
}

% Description — tcolorbox with red left bar
\renewcommand{\scpdescription}{%
  \vspace{6pt}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=scplightgray!60,
    colframe=scplightgray,
    boxrule=0pt,
    borderline west={2pt}{0pt}{scpred},
    sharp corners,
    left=6pt, right=5pt, top=3pt, bottom=3pt,
    fontupper=\sffamily\footnotesize
  ]%
  \textbf{\MakeUppercase{Description}}%
  \end{tcolorbox}%
  \vspace{2pt}%
}

% Addendum — tcolorbox with red left bar
\renewcommand{\addendum}[1]{%
  \vspace{6pt}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=scplightgray!60,
    colframe=scplightgray,
    boxrule=0pt,
    borderline west={2pt}{0pt}{scpred},
    sharp corners,
    left=6pt, right=5pt, top=3pt, bottom=3pt,
    fontupper=\sffamily\footnotesize
  ]%
  \textbf{\MakeUppercase{Addendum #1}}%
  \end{tcolorbox}%
  \vspace{2pt}%
}

% Object class — red boxed label
\renewcommand{\objectclass}[1]{%
  \vspace{4pt}%
  \noindent
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=scpred,
    boxrule=0.75pt,
    sharp corners,
    left=5pt, right=5pt, top=2pt, bottom=2pt,
    width=0.54\textwidth,
    fontupper=\sffamily\footnotesize
  ]%
  \textbf{OBJECT CLASS:} \MakeUppercase{#1}%
  \end{tcolorbox}%
  \vspace{4pt}%
}

% Speaker — red name in dialogue
\renewcommand{\speaker}[1]{%
  {\ttfamily\bfseries\color{scpred}#1:}%
}

% Log header
\renewcommand{\logheader}[1]{%
  {\sffamily\bfseries\color{scpblack}\MakeUppercase{#1}}\\[0.3cm]%
}

% ─── Override environments ───────────────────────────────────────────

% Quote block — thin gray frame box
\renewenvironment{scpquote}{%
  \vspace{4pt}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=scplightgray,
    colframe=scpgray!40,
    boxrule=0.5pt,
    sharp corners,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    fontupper=\small\itshape
  ]%
}{%
  \end{tcolorbox}%
  \vspace{4pt}%
}

% Dialogue block — black frame, monospace, transcript markers
\renewenvironment{scpdialogue}{%
  \vspace{4pt}%
  \begin{tcolorbox}[
    enhanced,
    breakable,
    colback=scplightgray!20,
    colframe=scpgray!70,
    boxrule=0.55pt,
    borderline west={1.3pt}{0pt}{scpblack},
    sharp corners,
    left=6pt, right=6pt, top=4pt, bottom=4pt,
    fontupper=\ttfamily\footnotesize,
    before upper={\noindent\sffamily\scriptsize\color{scpgray!90}\MakeUppercase{[Transcript Begin]}\par\vspace{2pt}\ttfamily}
  ]%
}{%
  \par\vspace{2pt}%
  \noindent{\sffamily\scriptsize\color{scpgray!90}\MakeUppercase{[Transcript End]}}%
  \end{tcolorbox}%
  \vspace{4pt}%
}

% ─── Title page ──────────────────────────────────────────────────────
\renewcommand{\scptitlepage}[3]{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture, overlay]
    % Page background
    \fill[scppaper] (current page.south west) rectangle (current page.north east);
    % Top red bar
    \fill[scpred] ([yshift=-1cm]current page.north west) rectangle
                    ([yshift=-1.3cm]current page.north east);
    % Bottom red bar
    \fill[scpred] ([yshift=1cm]current page.south west) rectangle
                    ([yshift=1.3cm]current page.south east);
  \end{tikzpicture}%
  %
  \vspace*{2cm}%
  %
  % TOP SECRET stamp
  \begin{center}
    \begin{tikzpicture}
      \node[
        draw=scpstamp,
        line width=3pt,
        rounded corners=2pt,
        rotate=-8,
        inner sep=8pt,
        font=\fontsize{28}{32}\selectfont\ttfamily\bfseries\color{scpstamp},
        opacity=0.8
      ] {TOP SECRET};
    \end{tikzpicture}
  \end{center}%
  %
  \vspace{1.5cm}%
  %
  % Title block
  \begin{center}
    {\fontsize{36}{42}\selectfont\ttfamily\bfseries\color{scpblack}%
     \MakeUppercase{#1}\par}%
    \vspace{0.5cm}%
    {\Large\sffamily\color{scpgray}#2\par}%
  \end{center}%
  %
  \vspace{1cm}%
  %
  % CLASSIFIED box
  \begin{center}
    \begin{tcolorbox}[
      enhanced,
      colback=scpred,
      colframe=scpred,
      boxrule=0pt,
      sharp corners,
      width=0.6\textwidth,
      halign=center,
      left=10pt, right=10pt, top=8pt, bottom=8pt,
      fontupper=\sffamily\bfseries\color{white}
    ]
      \centering
      \large CLASSIFIED\\[2pt]
      \normalsize LEVEL 4 CLEARANCE REQUIRED
    \end{tcolorbox}
  \end{center}%
  %
  \vspace*{\fill}%
  %
  % Document metadata
  \begin{center}
    {\sffamily\color{scpgray}%
     \small Document compiled by: #3\\[4pt]%
     \small Clearance verified: \today\\[4pt]%
     \scriptsize UNAUTHORIZED REPRODUCTION OR DISTRIBUTION\\[-1pt]%
     \scriptsize IS PUNISHABLE UNDER FOUNDATION PROTOCOL 4X-201%
    }%
  \end{center}%
  %
  \vspace{1cm}%
  \newpage
}

% ─── Chapter opener override ─────────────────────────────────────────
\renewcommand{\scpchapter}[1]{%
  \chapter{#1}%
}

% ─── Hyperref styling ────────────────────────────────────────────────
\hypersetup{
  colorlinks=true,
  linkcolor=scpdarkred,
  urlcolor=scpred,
  citecolor=scpgray
}

% ─── Load decorative stamps ─────────────────────────────────────────
\input{graphics/stamps}

\endinput
